{
  "manifest_version": 3,
  "name": "HABITAT · browser bridge",
  "version": "0.10.8",
  "minimum_chrome_version": "120",
  "description": "Connect HABITAT to ChatGPT, search and Translate, with optional automatic browser contacts and explicit Messenger submissions.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://chatgpt.com/*",
    "https://translate.google.com/*",
    "https://www.google.com/search*",
    "https://www.youtube.com/results*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://mail.google.com/*", "https://contacts.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HABITAT Browser Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/aesgalexis/habitat",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
