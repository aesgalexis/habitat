{
  "manifest_version": 3,
  "name": "HABITAT · browser bridge",
  "version": "0.8.0",
  "minimum_chrome_version": "120",
  "description": "Connect HABITAT to ChatGPT and bring Google, YouTube and Translate results back to the desktop.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://chatgpt.com/*",
    "https://translate.google.com/*",
    "https://www.google.com/search*",
    "https://www.youtube.com/results*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
