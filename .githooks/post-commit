#!/bin/sh
set -u

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ "$branch" != "codex/autosave" ]; then
  exit 0
fi

echo "HABITAT: enviando el checkpoint a origin/$branch..."
if ! git push --set-upstream origin "$branch"; then
  echo "HABITAT: el commit quedó guardado localmente, pero el push falló. Se reintentará en el próximo checkpoint." >&2
fi

exit 0
